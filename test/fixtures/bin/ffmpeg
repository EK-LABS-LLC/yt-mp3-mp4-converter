#!/usr/bin/env bash

# Deterministic ffmpeg stand-in for tests. -version prints a fixture version;
# the speech-to-text extraction invocation (matched by -y -hide_banner ... -i
# ... pcm_s16le <out.wav>) writes a minimal RIFF/WAVE header as its last arg.
# FFMPEG_FIXTURE_MODE=fail makes extraction exit nonzero.

set -euo pipefail

if [ "${1:-}" = "-version" ]; then
  printf 'ffmpeg version fixture-1.0.0\n'
  exit 0
fi

if [ "${FFMPEG_FIXTURE_MODE:-}" = "fail" ]; then
  printf 'ERROR: fixture ffmpeg failed to extract audio\n' >&2
  exit 1
fi

# Speech-to-text fixture: assert the expected resample args and write the last
# argument (the output WAV path) as a minimal RIFF/WAVE header.
if [ "$#" -ge 2 ] && [ "${1:-}" = "-y" ] && [ "$2" = "-hide_banner" ]; then
  if printf '%s ' "${@:1:$#-1}" | grep -q -- 'libmp3lame'; then
    output="${@: -1}"
    printf 'ID3 fixture MP3 audio' > "$output"
    exit 0
  fi
  if ! printf '%s ' "${@:1:$#-1}" | grep -Eq -- 'pcm_s16le|pcm_f32le'; then
    printf 'fixture ffmpeg expected pcm_s16le output\n' >&2
    exit 1
  fi
  output="${@: -1}"
  # RIFF....WAVEfmt .... 1ch 16000Hz PCM16
  printf 'RIFF\x24\x00\x00\x00WAVEfmt \x10\x00\x00\x00\x01\x00\x01\x00\x80\x3e\x00\x00\x00\x7d\x00\x00\x02\x00\x10\x00data\x00\x00\x00\x00' > "$output"
  exit 0
fi

printf 'fixture ffmpeg only supports -version and the STT WAV extraction\n' >&2
exit 1
