#!/usr/bin/env bun

// Deterministic whisper-cli stand-in for tests. It parses -f/<input> and
// -otxt exactly like the real CLI and writes `<input>.txt` with fixed text.
// Environment knobs:
//   WHISPER_FIXTURE_MODE=no-file  exit 0 without writing a transcript file
//   WHISPER_FIXTURE_MODE=empty    write an empty transcript file
//   WHISPER_FIXTURE_MODE=fail     exit nonzero with an error on stderr
//   WHISPER_FIXTURE_ECHO_OUTPUT=1 write the input path as the transcript text

const args = Bun.argv.slice(2);

function optionValue(name: string): string | undefined {
  const index = args.indexOf(name);
  return index >= 0 ? args[index + 1] : undefined;
}

function fail(message: string): never {
  console.error(message);
  process.exit(1);
}

if (args.includes("--version") || args.includes("--help")) {
  console.log("fixture-whisper-cli-1.0.0");
  process.exit(0);
}

const delay = Number(process.env.WHISPER_FIXTURE_DELAY_MS || "0");
if (delay > 0) await Bun.sleep(delay);

if (process.env.WHISPER_FIXTURE_MODE === "fail") {
  fail("ERROR: fixture whisper-cli failed to transcribe");
}

const input = optionValue("-f");
if (!input) {
  fail("ERROR: fixture expected an -f input path");
}

if (!args.includes("-otxt")) {
  fail("ERROR: fixture expected -otxt output");
}

if (process.env.WHISPER_FIXTURE_MODE === "no-file") {
  process.exit(0);
}

if (process.env.WHISPER_FIXTURE_MODE === "empty") {
  await Bun.write(`${input}.txt`, "");
  process.exit(0);
}

const transcript = process.env.WHISPER_FIXTURE_ECHO_OUTPUT === "1"
  ? `${input}\n`
  : "This is the local speech-to-text fixture transcript.\nNo captions were needed.\n";

await Bun.write(`${input}.txt`, transcript);
process.exit(0);
