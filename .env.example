# Web server
PORT=3000
DOWNLOAD_DIR=/tmp/yt-converter-downloads
MAX_FILE_SIZE_MB=500
# Defaults follow DOWNLOAD_DIR; override only when needed.
# STATE_DIR=/tmp/yt-converter-downloads/.state
# UPLOAD_DIR=/tmp/yt-converter-downloads/.uploads
JOB_CONCURRENCY=2
MAX_QUEUE_SIZE=10
MAX_PENDING_UPLOAD_BYTES=4294967296
MIN_FREE_DISK_BYTES=2147483648
JOB_TTL_SECONDS=259200
CLEANUP_INTERVAL_SECONDS=3600
SHUTDOWN_GRACE_SECONDS=300
UPLOAD_IDLE_TIMEOUT_SECONDS=60

# CLI
CLIENT_DOWNLOAD_DIR=./downloads

# MCP
MCP_TRANSCRIPT_DIR=/tmp/yt-transcript-mcp-cache

# Local instrumental separation: run scripts/setup-instrumental.sh once.
# DEMUCS_PATH=/absolute/path/to/.venv-instrumental/bin/demucs
INSTRUMENTAL_TIMEOUT_SECONDS=7200
