{
  "name": "yt-video-transcript-mcp",
  "version": "0.1.0",
  "description": "YouTube transcript downloader, web converter, CLI, and MCP stdio server.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theworksofvon/yt-mp3-mp4-converter.git"
  },
  "keywords": [
    "mcp",
    "youtube",
    "transcript",
    "captions",
    "yt-dlp"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/cli.ts",
    "src/errors.ts",
    "src/index.ts",
    "src/mcp.ts",
    "src/schemas.ts",
    "src/yt-dlp.ts",
    "public",
    "docs/MCP.md",
    "scripts/run-mcp.sh",
    "README.md"
  ],
  "bin": {
    "yt-video-transcript-mcp": "./src/mcp.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "setup": "bash scripts/setup.sh",
    "mcp": "bun src/mcp.ts",
    "cli": "bun run src/cli.ts",
    "mp3": "bun run src/cli.ts mp3",
    "mp4": "bun run src/cli.ts mp4",
    "transcript": "bun run src/cli.ts transcript",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:e2e": "playwright test",
    "test:integration": "RUN_INTEGRATION_TESTS=1 bun test src/yt-dlp.test.ts",
    "test:live": "bun scripts/live-smoke.ts",
    "check": "bun run typecheck && bun run test:coverage",
    "check:all": "bun run check && bun run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.11.4",
    "zod": "^4.3.5"
  }
}
